# Copy to .env:  cp env.example .env
# Docker Compose requires .env to exist (can be mostly empty).
# The app service already gets URLs and tuning from docker-compose.yml;
# use this file for secrets and overrides.

# --- Chat (Ollama local LLM; required) ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# Optional: override KB embedding model (defaults to OLLAMA_MODEL). Use e.g. nomic-embed-text if your chat model lacks /api/embeddings.
# RAG_OLLAMA_EMBED_MODEL=
# OLLAMA_NATIVE_TOOLS=1

# --- Security ---
# JWT_SECRET=change-me-in-production
# Shared with MCP marketplace API (MARKETPLACE_BRIDGE_SECRET) for POST /api/auth/marketplace-bridge.
# MARKETPLACE_BRIDGE_SECRET=

# --- Optional overrides (normally set in docker-compose.yml) ---
# CHATTERBOX_BASE_URL=http://127.0.0.1:8000
# Ditto talking-head (local docker: ditto-talkinghead maps host 8082→container 8080; avoid 8080 if marketplace uses it)
# DITTO_API_URL=http://127.0.0.1:8082
# Streaming Ditto (no POST /personas): faces are stored under ./data/ditto_faces on this machine; Ditto pulls them via HTTP:
# DITTO_FACE_FETCH_BASE_URL=http://172.17.0.1:8087   # URL *as seen from the Ditto container* to reach TwynBook (host:8087); try host.docker.internal on some setups
# DITTO_INTERNAL_FACE_SECRET=change-me   # Bearer secret TwynBook and Ditto WS config must share (GET /api/internal/ditto-faces/...)
# If persona create/preview 404, set the collection root Ditto uses (no trailing slash), e.g.:
# DITTO_PERSONAS_BASE_URL=http://127.0.0.1:8082/api/personas
# STT_BASE_URL=http://127.0.0.1:8090

# --- Chatterbox TTS streaming (TwynBook backend only; TTS_PROVIDER=chatterbox) ---
# CB_TTS_RAW_PCM=1          # 1=GET /api/tts/pcm (default); 0=WAV /api/tts/stream
# CB_FFMPEG_LOW_LATENCY=1   # nobuffer/low_delay ffmpeg (+ tight WAV probe if WAV)
# CB_HTTP_CHUNK_SIZE=32768  # httpx read size from Chatterbox (min 4096)

# --- Chatterbox Docker Compose service (optional; see docker-compose.yml) ---
# Image name for the `chatterbox` service (default app-chatterbox-api:latest).
# CHATTERBOX_IMAGE=app-chatterbox-api:latest
# Before `docker compose up -d chatterbox`, capture env from a running container (HF token, CUDA, etc.):
#   ./scripts/export-chatterbox-env.sh
# Writes docker-data/.env.chatterbox.runtime (gitignored under docker-data/).
